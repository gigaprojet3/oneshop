# Copiez ce fichier en .env.local et remplissez les valeurs
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL publique de l'application (liens de confirmation d'email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domaine des boutiques : chaque boutique est servie sur son sous-domaine (chez-awa.localhost:3000,
# chez-awa.oneshop.com en production). Laissez vide pour garder les adresses /boutique/chez-awa.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Clé secrète, côté serveur uniquement (abonnements). Ne jamais la publier.
SUPABASE_SECRET_KEY=
